<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>qwek</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultBackendUrl Condition="'$(DefaultBackendUrl)' == ''">http://localhost:5206</DefaultBackendUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Asset/qwek-logo.png" />
    <AssemblyMetadata Include="DefaultBackendUrl" Value="$(DefaultBackendUrl)" />
  </ItemGroup>

</Project>
